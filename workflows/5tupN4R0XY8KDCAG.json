    {
      "id": "26ec4ae3-4644-5304-8944-1695207d3fec",
      "name": "Signals",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n\nconst now = DateTime.now().setZone(TZ);\nconst stamp = now.toISO({ suppressMilliseconds: true });\nconst fetched = $('Comments').isExecuted;\nconst posts = fetched ? $('With Facebook ids').all().map((i) => i.json) : [];\nconst eng = fetched ? $('Engagement').all().map((i) => i.json || {}) : [];\nconst ins = fetched ? $('Insights').all().map((i) => i.json || {}) : [];\nconst com = fetched ? $('Comments').all().map((i) => i.json || {}) : [];\nconst squash = (t) => String(t || '').replace(/\\s+/g, ' ').trim();\nconst updates = [];\nconst events = [];\nposts.forEach((p, i) => {\n  const e = eng[i] || {};\n  if (e.error) { events.push({ type: 'metrics', post_id: p.Id, text: `Could not read post #${p.Id} from Facebook: ${e.error.message || JSON.stringify(e.error)}`, value: null }); return; }\n  const metric = (name) => {\n    const m = ((ins[i] || {}).data || []).find((x) => x.name === name);\n    return m && m.values && m.values.length ? Number(m.values[0].value) || 0 : null;\n  };\n  const row = {\n    Id: p.Id,\n    reach: metric('post_total_media_view_unique'),\n    clicks: metric('post_clicks'),\n    reactions: (e.reactions && e.reactions.summary && e.reactions.summary.total_count) || 0,\n    comments: (e.comments && e.comments.summary && e.comments.summary.total_count) || 0,\n    shares: (e.shares && e.shares.count) || 0,\n    metrics_at: stamp,\n    final_text: p.final_text || p.draft,\n  };\n  if (e.message !== undefined && squash(e.message) !== squash(row.final_text)) {\n    events.push({ type: 'edit_diff', post_id: p.Id, text: `Post #${p.Id} was edited on Facebook.\\nBefore: ${row.final_text}\\nAfter: ${e.message}`, value: null });\n    row.final_text = e.message;\n  }\n  updates.push(row);\n  // Runs once a day, so each window is crossed once.\n  const age = now.diff(parseDt(p.published_at), 'hours').hours;\n  const label = age >= 24 && age < 48 ? '1 day' : age >= 168 && age < 192 ? '7 days' : '';\n  if (label) {\n    const engagement = row.reactions + 2 * row.comments + 3 * row.shares;\n    events.push({ type: 'metrics', post_id: p.Id, value: engagement, text: `Post #${p.Id} (${p.kind}, hook ${p.hook_type || '-'}) after ${label}: ${row.reach ?? '?'} unique viewers, ${row.reactions} reactions, ${row.comments} comments, ${row.shares} shares, ${row.clicks ?? '?'} clicks. Tested: ${p.hypothesis || '-'}` });\n  }\n  ((com[i] || {}).data || [])\n    .filter((c) => squash(c.message))\n    .forEach((c) => events.push({ type: 'audience_comment', post_id: p.Id, value: Number(c.like_count) || 0, text: `On post #${p.Id} \"${p.title}\": ${squash(c.message)}` }));\n});\nconst followers = Number(($('Page').first().json || {}).followers_count);\nif (Number.isFinite(followers) && followers > 0) events.push({ type: 'followers', post_id: null, value: followers, text: `${followers} followers` });\nreturn [{ json: { updates, events, stamp } }];"
      },
