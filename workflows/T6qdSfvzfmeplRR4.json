      "name": "Timed out pick",
      "parameters": {
        "jsCode": "// No approval within a day: write from the structure the judge picked.\nreturn $input.all().map((item) => {\n  const row = item.json;\n  const chosen = [1, 2, 3].includes(Number(row.chosen_structure)) ? Number(row.chosen_structure) : 1;\n  return {\n    json: {\n      Id: row.Id,\n      title: row.title,\n      draft: row.draft,\n      platform: row.platform,\n      goal: row.goal,\n      clarifying_qa: row.clarifying_qa,\n      evaluation: row.evaluation,\n      chosen_structure: chosen,\n      structure_text: row['structure_' + chosen] || '',\n      finalized_by: 'auto',\n    },\n  };\n});"
