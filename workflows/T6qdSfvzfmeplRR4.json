      "name": "Approved pick",
      "parameters": {
        "jsCode": "// The link carries the structure you chose; fall back to the judge's pick.\nconst query = $('Approval link clicked').first().json.query || {};\nconst row = $input.first().json;\n\nconst asked = Number(query.structure);\nconst chosen = [1, 2, 3].includes(asked) ? asked : Number(row.chosen_structure) || 1;\n\nreturn [\n  {\n    json: {\n      Id: row.Id,\n      title: row.title,\n      draft: row.draft,\n      platform: row.platform,\n      goal: row.goal,\n      clarifying_qa: row.clarifying_qa,\n      evaluation: row.evaluation,\n      chosen_structure: chosen,\n      structure_text: row['structure_' + chosen] || '',\n      finalized_by: 'approved',\n    },\n  },\n];"
      },
      "position": [
        60,
        -120
      ],
      "type": "n8n-nodes-base.code",
