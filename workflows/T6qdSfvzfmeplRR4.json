    {
      "id": "5a863769-b69a-4470-ae0d-07e653f83b3f",
      "name": "Write final content",
      "parameters": {
        "messages": {
          "messageValues": [
            {
              "message": "You write the finished post from an approved structure. Follow the structure's hook, beats and CTA; do not invent a different angle.\n\nRules:\n- Use only facts from the draft and the clarifying answers. Invent no numbers, names or events. If a beat needs a detail that is missing, write it in a way that still works without it.\n- Open with the structure's hook, tightened if it can be tighter.\n- Short paragraphs, one idea each. No headings unless the structure asks for them. No hashtags unless the platform is one where they work.\n- Sound like a person talking, not a brand. Cut every sentence that carries no information.\n- Output the post text only: no title, no commentary, no notes about what you did.\n- Write in the language of the draft."
            }
          ]
        },
        "promptType": "define",
        "text": "=Platform: {{ $json.platform }}\nGoal: {{ $json.goal }}\n\nDraft idea:\n{{ $json.draft }}\n\nClarifying questions and answers:\n{{ $json.clarifying_qa }}\n\nApproved structure:\n{{ $json.structure_text }}"
      },
      "position": [
