      "name": "Reminders",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n\nreturn rowsOf('Load due pieces').map((p) => {\n  const at = parseDt(p.publish_at);\n  return {\n    json: {\n      piece_id: p.Id,\n      publish_at: p.publish_at,\n      text: `⏰ Post on the page at ${at.toFormat('HH:mm dd/MM')}: ${p.title}\\n\\n${p.draft}`,\n      ref: `piece:${p.Id}`,\n      purpose: 'post_reminder',\n    },\n  };\n});"
      },
