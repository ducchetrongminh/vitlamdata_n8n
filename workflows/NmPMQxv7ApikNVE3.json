    {
      "id": "131aa116-79de-59ef-b643-e5fc3c9d7a04",
      "name": "Build cycles",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n\nconst month = ($('When called').first().json.month || '').toString().trim();\nif (!/^\\d{4}-\\d{2}$/.test(month)) throw new Error(`Plan month needs {month: \"YYYY-MM\"}, got \"${month}\"`);\nconst ctx = $('Get context').first().json;\nconst offers = rowsOf('Load offers');\nconst pieces = rowsOf('Load pieces');\nconst stories = rowsOf('Load stories');\nconst today = DateTime.now().setZone(TZ).startOf('day');\n\nconst taken = new Set(pieces.map((p) => parseDt(p.publish_at).toISODate()));\nconst active = offers\n  .filter((o) => ['approved', 'planned', 'done'].includes(o.status) && o.launch_date && o.reminder_date)\n  .sort((a, b) => (a.launch_date < b.launch_date ? -1 : 1));\nconst toPlan = active.filter((o) => o.month === month && o.status === 'approved');\n\nconst storyList = stories.map((s) => ({ id: s.Id, text: (s.text || '').toString().slice(0, 600) }));\n\nconst cycles = [];\nfor (const offer of toPlan) {\n  const prev = active[active.indexOf(offer) - 1];\n  const launch = parseDate(offer.launch_date);\n  const reminder = parseDate(offer.reminder_date);\n  let start = DateTime.max(today.plus({ days: 1 }), launch.minus({ days: 30 }));\n  if (prev) start = DateTime.max(start, parseDate(prev.reminder_date).plus({ days: 1 }));\n  const slots = [];\n  for (let d = start; d <= reminder; d = d.plus({ days: 1 })) {\n    const iso = d.toISODate();\n    if (taken.has(iso)) continue;\n    const kind = iso === launch.toISODate() ? 'offer_launch' : iso === reminder.toISODate() ? 'offer_reminder' : 'open';\n    slots.push({ date: iso, weekday: d.toFormat('cccc'), kind });\n    taken.add(iso);\n  }\n  if (!slots.length) continue;\n  cycles.push({\n    json: {\n      offer,\n      slots,\n      month,\n      stories: storyList,\n      brand: ctx.brand,\n      rules: ctx.rules,\n      page_name: ctx.page_name,\n      language: ctx.language,\n      post_time: ctx.post_time,\n    },\n  });\n}\nif (!cycles.length) {\n  return [{ json: { skip: true, text: `Nothing to plan for ${month}: no approved offer with free days left.`, ref: `month:${month}`, purpose: 'plan_summary' } }];\n}\nreturn cycles;"
      },
