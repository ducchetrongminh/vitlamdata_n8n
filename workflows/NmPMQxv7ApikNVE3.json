    {
      "id": "be294a3d-ed07-5bcd-8ced-4ba1bbfce18f",
      "name": "Plan summary",
      "parameters": {
        "jsCode": "const month = $('When called').first().json.month;\nconst label = { education: 'edu', story: 'story', offer_launch: 'LAUNCH', offer_reminder: 'REMINDER' };\nconst fmt = (d) => `${d.slice(8, 10)}/${d.slice(5, 7)}`;\nconst cycles = $input.all().map((i) => i.json).filter((c) => c.pieces);\nconst total = cycles.reduce((n, c) => n + c.pieces.length, 0);\nconst asks = cycles.reduce((n, c) => n + c.pieces.filter((p) => p.needs_material).length, 0);\nconst text = [\n  `🗓 Plan for ${month}: ${total} posts.`,\n  ...cycles.map((c) => [\n    '',\n    `${c.offer_title} (launch ${fmt(c.launch_date)}, reminder ${fmt(c.reminder_date)})`,\n    ...c.pieces.map((p) => `${fmt(p.date)} ${label[p.kind] || p.kind}: ${p.title}${p.needs_material ? ' ❓' : ''}`),\n  ].join('\\n')),\n  '',\n  asks ? `❓ ${asks} post(s) need a real detail from you: I ask about each a week before it goes out.` : '',\n  'Drafts arrive for approval a few days before each post.',\n].filter((l) => l !== null).join('\\n');\nreturn [{ json: { text, ref: `month:${month}`, purpose: 'plan_summary' } }];"
      },
