      "name": "Message",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => ($(name).isExecuted ? $(name).all() : [])\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst linesOf = (v) => String(v || '').split('\\n').map((s) => s.trim()).filter(Boolean);\n// NocoDB returns DateTime in UTC as \"2026-09-17 13:00:00+00:00\".\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst iso = (dt) => dt.setZone(TZ).toISO({ suppressMilliseconds: true });\n\nconst e = $('On error').first().json;\nconst x = e.execution || {};\nconst s = settingsOf('Load settings');\nconst text = `⚠️ ${(e.workflow || {}).name || 'Content crew'} hỏng ở \"${x.lastNodeExecuted || '?'}\": ${((x.error || {}).message || 'không rõ lỗi').slice(0, 1500)}${x.url ? `\\n${x.url}` : ''}`;\nreturn [{ json: { receive_id: s.lark_chat_id || s.lark_open_id, id_type: s.lark_chat_id ? 'chat_id' : 'open_id', text } }];"
      },
