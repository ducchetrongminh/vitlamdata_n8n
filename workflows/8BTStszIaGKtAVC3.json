      "name": "Build row",
      "parameters": {
        "jsCode": "// Only non-empty inputs are written, so a re-capture never blanks a field, and notes stay\n// the user's. captured_at records the first capture.\nconst input = $('When Executed by Another Workflow').first().json;\nconst existingId = $input.first().json.id ?? '';\nconst keys = ['post_url', 'hook', 'author_name', 'author_url', 'source_type', 'posted_at', 'format',\n  'text', 'reaction_count', 'comment_count', 'share_count', 'comments', 'why_it_works'];\nconst fields = {};\nfor (const key of keys) {\n  const value = input[key];\n  if (value !== undefined && value !== null && value !== '') fields[key] = value;\n}\nif (!fields.post_url) throw new Error('post_url is required');\nif (!existingId) fields.captured_at = $now.toISO({ suppressMilliseconds: true });\nreturn [{ json: { id: existingId, fields } }];"
      },
