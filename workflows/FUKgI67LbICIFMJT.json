    {
      "id": "63c4af47-1379-5e93-8814-d68b75467859",
      "name": "Decide",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n// settings.post_window, e.g. \"07:00-22:00\": the times posts may go out.\nconst windowOf = (v) => {\n  const m = String(v || '').match(/(\\d{1,2}):(\\d{2})\\s*-\\s*(\\d{1,2}):(\\d{2})/);\n  return m ? { from: `${m[1].padStart(2, '0')}:${m[2]}`, to: `${m[3].padStart(2, '0')}:${m[4]}` } : { from: '07:00', to: '22:00' };\n};\nconst validTime = (t) => /^([01]\\d|2[0-3]):[0-5]\\d$/.test(t);\nconst slotOf = (dt) => { const h = Math.floor(dt.hour / 3) * 3; return `${String(h).padStart(2, '0')}-${String(h + 3).padStart(2, '0')}h`; };\n\nconst c = $('Classify').first().json;\nconst settings = settingsOf('Load settings');\nif (!settings.lark_open_id || c.operator !== settings.lark_open_id) return [];\nconst row = rowsOf('Load row')[0];\nconst isOffer = String(c.action || '').startsWith('offer');\nconst approve = String(c.action || '').endsWith('approve');\nconst open = isOffer ? ['proposed'] : ['awaiting_approval'];\nconst base = { reply_to: c.message_id };\nif (!row || !c.token || row.approval_token !== c.token) {\n  return [{ json: { ...base, valid: false, text: 'That card is out of date.' } }];\n}\nif (!open.includes(row.status)) {\n  return [{ json: { ...base, valid: false, text: `${isOffer ? 'Offer' : 'Post'} #${row.Id} is already ${row.status}.` } }];\n}\nconst label = isOffer ? `offer #${row.Id} \"${row.title}\" (${row.offer}, launch ${row.launch_date})` : `post #${row.Id} \"${row.title}\"`;\nlet agent = '';\nif (isOffer && approve) agent = `Your manager approved ${label}. Plan the posts leading to it now, working backward from what the audience must know and feel.`;\nif (isOffer && !approve) agent = `Your manager rejected ${label}. If you do not know why, ask in one short message. Then propose a different offer for that month.`;\nif (!isOffer && !approve) agent = `Your manager rejected ${label}, planned for ${row.publish_at}. If you do not know why, ask in one short message; then plan something better for that day.`;\nreturn [{\n  json: {\n    ...base,\n    valid: true,\n    table: isOffer ? 'offers' : 'posts',\n    row_id: row.Id,\n    status: approve ? 'approved' : 'rejected',\n    event: { type: approve ? 'approved' : 'rejected', post_id: isOffer ? null : row.Id, offer_id: isOffer ? row.Id : null, text: `Manager ${approve ? 'approved' : 'rejected'} ${label}` },\n    agent,\n    text: approve ? `✅ Approved ${isOffer ? 'offer' : 'post'} #${row.Id}.` : `Rejected ${isOffer ? 'offer' : 'post'} #${row.Id}.`,\n  },\n}];"
      },
