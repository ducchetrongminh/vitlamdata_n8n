    {
      "id": "15f4dbdd-50b2-5c6c-bf4c-9382abe2a3ef",
      "name": "Agent input",
      "parameters": {
        "jsCode": "const m = $('Read message').first().json;\nlet replyTo = '';\nlet postId = null;\nlet offerId = null;\nif ($('Fetch parent').isExecuted) {\n  const p = (($('Fetch parent').first().json.data || {}).items || [])[0];\n  if (p) {\n    const raw = (p.body && p.body.content) || '';\n    let plain = raw;\n    try {\n      const c = JSON.parse(raw);\n      plain = c.text || JSON.stringify(c).replace(/\"(tag|type|template|schema|behaviors|value|width|flex_mode)\":\"[^\"]*\",?/g, '').replace(/[{}\\[\\]\"]/g, ' ').replace(/\\s+/g, ' ');\n    } catch (e) {}\n    replyTo = plain.slice(0, 1500);\n    const post = raw.match(/[Pp]ost #(\\d+)/);\n    const offer = raw.match(/[Oo]ffer #(\\d+)/);\n    postId = post ? Number(post[1]) : null;\n    offerId = offer ? Number(offer[1]) : null;\n  }\n}\nconst lines = [];\nif (m.link) lines.push('(This is the first message from your manager: introduce yourself in two lines and, if goals or brand docs are missing, ask for them.)');\nif (replyTo) lines.push(`They replied to this message of yours: <<<\n${replyTo}\n>>>`);\nlines.push(`Your manager wrote: <<<\n${m.text}\n>>>`);\nreturn [{\n  json: {\n    mode: 'chat',\n    text: lines.join('\\n'),\n    reply_to: m.message_id,\n    open_id: m.open_id,\n    event: {\n      type: postId && replyTo ? 'change_request' : 'manager_note',\n      post_id: postId,\n      offer_id: offerId,\n      text: replyTo ? `${m.text}\\n(in reply to: ${replyTo.slice(0, 300)})` : m.text,\n    },\n  },\n}];"
