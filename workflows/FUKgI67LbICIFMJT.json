    {
      "id": "681f01c7-f06c-5854-a554-91d07195d6f7",
      "name": "Classify",
      "parameters": {
        "jsCode": "// route: 0 card button, 1 message, 2 ignore\nconst body = $json.body || {};\nif (body.encrypt) return [{ json: { route: 2, response: {} } }];\nif (body.type === 'url_verification') return [{ json: { route: 2, response: { challenge: body.challenge } } }];\nconst header = body.header || {};\nconst event = body.event || {};\nif (header.event_type === 'card.action.trigger') {\n  const value = (event.action && event.action.value) || {};\n  return [{\n    json: {\n      route: 0,\n      response: { toast: { type: 'info', content: 'Noted' } },\n      action: value.a,\n      id: Number(value.id) || 0,\n      token: value.t,\n      operator: (event.operator && event.operator.open_id) || '',\n      message_id: (event.context && event.context.open_message_id) || '',\n    },\n  }];\n}\nif (header.event_type === 'im.message.receive_v1') {\n  const m = event.message || {};\n  if (m.chat_type !== 'p2p') return [{ json: { route: 2, response: {} } }];\n  return [{ json: { route: 1, response: {}, message_id: m.message_id } }];\n}\nreturn [{ json: { route: 2, response: {} } }];"
      },
