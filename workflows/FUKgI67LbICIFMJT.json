        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n// settings.post_window, e.g. \"07:00-22:00\": the times posts may go out.\nconst windowOf = (v) => {\n  const m = String(v || '').match(/(\\d{1,2}):(\\d{2})\\s*-\\s*(\\d{1,2}):(\\d{2})/);\n  return m ? { from: `${m[1].padStart(2, '0')}:${m[2]}`, to: `${m[3].padStart(2, '0')}:${m[4]}` } : { from: '07:00', to: '22:00' };\n};\nconst validTime = (t) => /^([01]\\d|2[0-3]):[0-5]\\d$/.test(t);\nconst slotOf = (dt) => { const h = Math.floor(dt.hour / 3) * 3; return `${String(h).padStart(2, '0')}-${String(h + 3).padStart(2, '0')}h`; };\n\nconst settings = settingsOf('Load settings');\nconst r = $json;\nif (r.code !== 0) throw new Error(`Lark get message failed: ${r.code} ${r.msg}`);\nconst m = ((r.data && r.data.items) || [])[0];\nif (!m || !m.sender || m.sender.sender_type !== 'user') return [];\nif (settings.lark_open_id && m.sender.id !== settings.lark_open_id) return [];\n\nconst textOf = (msg) => {\n  try {\n    const c = JSON.parse((msg.body && msg.body.content) || '{}');\n    if (msg.msg_type === 'text') return c.text || '';\n    if (msg.msg_type === 'post') {\n      const blocks = Array.isArray(c.content) ? c.content : [];\n      return [c.title || '', ...blocks.map((line) => (Array.isArray(line) ? line : []).map((el) => el.text || el.href || '').join(''))].filter(Boolean).join('\\n');\n    }\n  } catch (e) {}\n  return '';\n};\nconst text = textOf(m).replace(/@_user_\\d+/g, '').trim();\nif (!text) return [];\nconst settingsRow = $('Load settings').all().map((i) => i.json).find((j) => j.fields && j.fields.key === 'lark_open_id');\nreturn [{\n  json: {\n    text,\n    message_id: m.message_id,\n    parent_id: m.parent_id || '',\n    open_id: m.sender.id,\n    link: !settings.lark_open_id,\n    settings_row_id: settingsRow ? settingsRow.id : null,\n    auth: $('Get Lark token').first().json.tenant_access_token,\n  },\n}];"
