    {
      "id": "d23428aa-4c74-5adf-bb31-1b1c3e64bf6d",
      "name": "Build message",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n\nconst tokenResponse = $('Get Lark token').first().json;\nconst token = tokenResponse.tenant_access_token;\nif (!token) throw new Error('No Lark tenant token: ' + JSON.stringify(tokenResponse).slice(0, 300));\nconst settings = settingsOf('Load settings');\n\nconst out = [];\nfor (const item of $('When called').all()) {\n  const m = item.json || {};\n  const text = (m.text || '').toString();\n  if (!m.card && !text.trim()) continue;\n  if (!m.reply_to && !settings.lark_open_id) {\n    throw new Error('Lark is not linked yet: send the bot any message first.');\n  }\n  const msg_type = m.card ? 'interactive' : 'text';\n  const content = JSON.stringify(m.card ? m.card : { text: text.slice(0, 20000) });\n  out.push({\n    json: {\n      url: m.reply_to\n        ? `https://open.larksuite.com/open-apis/im/v1/messages/${m.reply_to}/reply`\n        : 'https://open.larksuite.com/open-apis/im/v1/messages?receive_id_type=open_id',\n      body: m.reply_to ? { msg_type, content } : { receive_id: settings.lark_open_id, msg_type, content },\n      token,\n      ref: m.ref || '',\n      purpose: m.purpose || 'reply',\n    },\n  });\n}\nreturn out;"
      },
