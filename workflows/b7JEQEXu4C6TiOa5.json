        "jsCode": "// Lark answers HTTP 200 with a non-zero code on some errors.\nconst built = $('Build message').all();\nreturn $input.all().map((item, i) => {\n  const r = item.json || {};\n  if (r.code !== 0) throw new Error(`Lark send failed: ${r.code} ${r.msg}`);\n  return { json: { message_id: r.data.message_id, ref: built[i].json.ref, purpose: built[i].json.purpose } };\n});"
