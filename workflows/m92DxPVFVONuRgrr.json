    {
      "id": "1d362c41-ba9b-55d9-84bf-f8172bff88c1",
      "name": "Outcome",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n\nconst due = $('Due now').all();\nconst now = DateTime.now().setZone(TZ).toISO({ suppressMilliseconds: true });\nreturn $input.all().map((item, i) => {\n  const post = due[i].json;\n  const r = item.json || {};\n  if (r.id) {\n    const [pageId, postId] = String(r.id).split('_');\n    return { json: { Id: post.Id, ok: true, status: 'published', fb_post_id: r.id, published_at: now, final_text: post.message, check_report: post.check_report, link: `https://www.facebook.com/${pageId}/posts/${postId}`, title: post.title } };\n  }\n  const reason = (r.error && (r.error.message || JSON.stringify(r.error))) || 'no post id returned';\n  return { json: { Id: post.Id, ok: false, status: 'publish_failed', fb_post_id: null, published_at: null, final_text: null, check_report: `Facebook refused it: ${reason}`, title: post.title } };\n});"
      },
