      "name": "Reminders",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n\n// The NocoDB filter compares dates only; keep what is due within the hour.\nconst until = DateTime.now().setZone(TZ).plus({ hours: 1 });\nreturn rowsOf('Load due posts').filter((p) => parseDt(p.publish_at) <= until).map((p) => ({\n  json: {\n    post_id: p.Id,\n    publish_at: p.publish_at,\n    text: `⏰ Post #${p.Id}, due ${parseDt(p.publish_at).toFormat('HH:mm dd/MM')}. Copy it to the page:\\n\\n${p.draft}`,\n  },\n}));"
      },
