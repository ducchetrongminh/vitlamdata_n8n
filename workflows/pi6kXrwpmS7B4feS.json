    {
      "id": "818ea56f-1eca-58c0-8b53-48c4bc752bc3",
      "name": "Decide",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n\n// route: 0 offer approved, 1 offer rejected, 2 piece approved, 3 piece rejected, 4 reply only\nconst input = $('When called').first().json;\nconst settings = settingsOf('Load settings');\nif (!settings.lark_open_id || input.operator !== settings.lark_open_id) return [];\n\nconst row = rowsOf('Load row')[0];\nconst now = DateTime.now().setZone(TZ);\nconst at = row && row.publish_at ? parseDt(row.publish_at) : null;\nlet route = 4;\nlet text = 'That card is out of date: use the newest card for this item.';\nlet update = null;\n\nif (row && input.token && row.approval_token === input.token) {\n  const a = input.action;\n  if (a === 'offer_approve' || a === 'offer_reject') {\n    if (row.status !== 'proposed') {\n      text = `\"${row.title}\" is already ${row.status}.`;\n    } else if (a === 'offer_approve') {\n      route = 0;\n      update = { status: 'approved', approved_at: now.toISO({ suppressMilliseconds: true }) };\n      text = `✅ Approved: ${row.title}. Planning starts once ${row.month} has two approved offers.`;\n    } else {\n      route = 1;\n      update = { status: 'rejected' };\n      text = `Rejected: ${row.title}. Proposing a replacement; reply to the new card to steer it.`;\n    }\n  } else if (a === 'piece_approve' || a === 'piece_reject') {\n    const open = ['awaiting_approval', 'needs_attention'];\n    if (a === 'piece_approve' && open.includes(row.status)) {\n      route = 2;\n      update = { status: 'approved', approved_at: now.toISO({ suppressMilliseconds: true }) };\n      text = `✅ Approved: ${row.title}. I send it to you to post at ${at.toFormat('HH:mm dd/MM')}.`;\n    } else if (a === 'piece_reject' && [...open, 'approved'].includes(row.status)) {\n      route = 3;\n      update = { status: 'rejected' };\n      text = `Rejected: ${row.title}. Its day stays empty. To get a rewrite instead, reply to the card with what to change.`;\n    } else {\n      text = `\"${row.title}\" is ${row.status}; nothing changed.`;\n    }\n  }\n}\n\nreturn [{\n  json: {\n    route,\n    table: String(input.action || '').startsWith('offer') ? 'offers' : 'pieces',\n    row_id: row ? row.Id : null,\n    month: row ? row.month : null,\n    title: row ? row.title : null,\n    offer: row ? row.offer : null,\n    update,\n    text,\n    reply_to: input.message_id,\n    purpose: 'reply',\n  },\n}];"
      },
