    {
      "id": "6ed52b2b-1f65-596e-989b-101fa0f0ac37",
      "name": "Material messages",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n\nconst settings = settingsOf('Load settings');\nconst draftLead = Number(settings.draft_lead_days) || 3;\nreturn $input.all().map((i) => {\n  const p = i.json.piece;\n  const at = parseDt(p.publish_at);\n  return {\n    json: {\n      piece_id: p.Id,\n      text: `❓ For ${at.toFormat('dd/MM')} (${p.kind}): ${p.title}\\n\\n${p.material_question}\\n\\nReply to this message with what really happened. The draft is written around ${at.minus({ days: draftLead }).toFormat('dd/MM')}, with or without it.`,\n      ref: `piece:${p.Id}`,\n      purpose: 'material_request',\n    },\n  };\n});"
      },
