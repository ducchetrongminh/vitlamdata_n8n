    {
      "id": "b7bf0a34-0412-59fe-a5f6-590d2ccb5bea",
      "name": "Due work",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n\nconst settings = settingsOf('Load settings');\nconst draftLead = Number(settings.draft_lead_days) || 3;\nconst materialLead = Number(settings.material_lead_days) || 7;\nconst now = DateTime.now().setZone(TZ);\nconst out = [];\n\nfor (const p of rowsOf('Load open pieces')) {\n  const at = parseDt(p.publish_at);\n  if (!at.isValid) continue;\n  const waiting = Boolean((p.material_question || '').trim()) && !(p.material || '').trim();\n  const asked = p.material_asked_at ? parseDt(p.material_asked_at) : null;\n  if (waiting && !asked && at <= now.plus({ days: materialLead })) {\n    out.push({ json: { job: 0, piece: p } });\n  } else if (at <= now.plus({ days: draftLead })\n    && (!waiting || at <= now.plus({ days: 1 }) || (asked && asked <= now.minus({ days: 1 })))) {\n    out.push({ json: { job: 1, piece_id: p.Id } });\n  }\n}\nfor (const o of rowsOf('Load ended offers')) {\n  if (!o.result_asked_at) out.push({ json: { job: 2, offer: o } });\n}\nreturn out;"
      },
      "position": [
        880,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
