    {
      "id": "4eefcb53-dc7b-5c9d-a59c-5553703ed011",
      "name": "Command",
      "parameters": {
        "jsCode": "// cmd: 0 offers, 1 plan, 2 status, 3 draft, 4 retro, 5 reply only\nconst msg = $('Read message').first().json;\nconst [name, arg = ''] = msg.text.trim().split(/\\s+/);\nconst month = /^\\d{4}-\\d{2}$/.test(arg) ? arg : '';\nconst reply = (text, extra = {}) => [{ json: { cmd: 5, text, reply_to: msg.message_id, ...extra } }];\nswitch (name.toLowerCase()) {\n  case '/offers':\n    return [{ json: { cmd: 0, month, replace_proposed: true, text: `Proposing offers for ${month || 'next month'}. The card comes in a minute or two.`, reply_to: msg.message_id } }];\n  case '/plan':\n    if (!month) return reply('Usage: /plan YYYY-MM');\n    return [{ json: { cmd: 1, month, text: `Planning ${month}. The plan comes in a few minutes.`, reply_to: msg.message_id } }];\n  case '/status':\n    return [{ json: { cmd: 2, text: '', reply_to: msg.message_id } }];\n  case '/draft':\n    if (!/^\\d+$/.test(arg)) return reply('Usage: /draft <piece id>');\n    return [{ json: { cmd: 3, piece_id: Number(arg), text: `Drafting piece ${arg}.`, reply_to: msg.message_id } }];\n  case '/retro':\n    return [{ json: { cmd: 4, month, text: `Writing the retro for ${month || 'last month'}.`, reply_to: msg.message_id } }];\n  default:\n    return reply($('Help text').first().json.help);\n}"
      },
      "position": [
        1980,
        -400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "alwaysOutputData": true,
