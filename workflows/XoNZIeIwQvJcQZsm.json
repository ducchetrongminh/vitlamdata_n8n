    {
      "id": "79fa7eda-1b9a-5343-ad8f-7530105eecef",
      "name": "Read message",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n\n// route: 0 link, 1 not text, 2 command, 3 reply to the bot, 4 story\nconst settings = settingsOf('Load settings');\nconst r = $json;\nif (r.code !== 0) throw new Error(`Lark get message failed: ${r.code} ${r.msg}`);\nconst m = ((r.data && r.data.items) || [])[0];\nif (!m || !m.sender || m.sender.sender_type !== 'user') return [];\nconst openId = m.sender.id;\nif (settings.lark_open_id && openId !== settings.lark_open_id) return [];\n\nlet text = '';\ntry {\n  const c = JSON.parse((m.body && m.body.content) || '{}');\n  if (m.msg_type === 'text') text = c.text || '';\n  if (m.msg_type === 'post') {\n    const blocks = Array.isArray(c.content) ? c.content : [];\n    text = [c.title || '', ...blocks.map((line) => (Array.isArray(line) ? line : []).map((el) => el.text || el.href || '').join(''))]\n      .filter(Boolean).join('\\n');\n  }\n} catch (e) {\n  text = '';\n}\ntext = text.replace(/@_user_\\d+/g, '').trim();\n\nconst route = !settings.lark_open_id ? 0 : !text ? 1 : text.startsWith('/') ? 2 : m.parent_id ? 3 : 4;\nconst settingsRow = $('Load settings').all().map((i) => i.json).find((j) => j.fields && j.fields.key === 'lark_open_id');\nreturn [{\n  json: {\n    route,\n    text,\n    open_id: openId,\n    message_id: m.message_id,\n    parent_id: m.parent_id || '',\n    settings_row_id: settingsRow ? settingsRow.id : null,\n  },\n}];"
      },
