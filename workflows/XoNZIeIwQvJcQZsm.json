    {
      "id": "e0f9ff5d-4fc5-5e7f-b1c0-fc71565f3f29",
      "name": "Reply target",
      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n\n// target: 0 offers card, 1 draft card, 2 material question, 3 result question, 4 retro, 5 story, 6 reply only\nconst msg = $('Read message').first().json;\nconst parent = rowsOf('Find parent')[0] || {};\nconst [kind, id] = String(parent.ref || '').split(':');\nconst base = { text_in: msg.text, reply_to: msg.message_id };\nif (parent.purpose === 'offer_card' && kind === 'month') {\n  return [{ json: { ...base, target: 0, month: id, text: `Re-proposing offers for ${id} with your note.` } }];\n}\nif (kind === 'piece' && parent.purpose === 'draft_card') {\n  return [{ json: { ...base, target: 1, piece_id: Number(id), text: 'Rewriting it with your note. The new draft replaces this card.' } }];\n}\nif (kind === 'piece' && parent.purpose === 'material_request') {\n  return [{ json: { ...base, target: 2, piece_id: Number(id), text: 'Thanks. Writing that post now with what you told me.' } }];\n}\nif (kind === 'offer' && parent.purpose === 'result_request') {\n  const t = msg.text;\n  const sales = t.match(/(\\d+)\\s*(sales?|đơn|orders?|học viên|khách|người|suất|slots?)(?![\\p{L}])/iu);\n  const rev = t.match(/(\\d+(?:[.,]\\d+)*)\\s*(triệu|tr|nghìn|ngàn|vnđ|vnd|đ|k|m)(?![\\p{L}\\d])/iu);\n  let revenue = null;\n  if (rev) {\n    const unit = rev[2].toLowerCase();\n    const scale = /^(tr|triệu|m)/.test(unit) ? 1e6 : /^(k|nghìn|ngàn)/.test(unit) ? 1e3 : 1;\n    const num = scale === 1 ? Number(rev[1].replace(/[.,]/g, '')) : Number(rev[1].replace(',', '.'));\n    revenue = Number.isFinite(num) ? Math.round(num * scale) : null;\n  }\n  const salesCount = sales ? Number(sales[1]) : null;\n  return [{\n    json: {\n      ...base, target: 3, offer_id: Number(id), sales_count: salesCount, revenue,\n      text: `Saved for the retro: ${salesCount ?? '?'} sales, ${revenue !== null ? revenue.toLocaleString('en-US') + ' VND' : 'revenue ?'}. Reply again to correct it.`,\n    },\n  }];\n}\nif (['reply', 'error', 'plan_summary', 'post_reminder'].includes(parent.purpose)) {\n  return [{ json: { ...base, target: 6, text: 'Noted. To change a post, reply to its draft card; to change offers, reply to the offers card.' } }];\n}\nif (kind === 'retro') {\n  return [{ json: { ...base, target: 4, retro_id: Number(id), text: 'Added to the rules for next month.' } }];\n}\nreturn [{ json: { ...base, target: 5, text: '' } }];"
      },
