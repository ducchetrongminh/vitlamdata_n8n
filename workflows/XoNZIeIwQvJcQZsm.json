    {
      "id": "2788c03c-28e1-5a0b-b458-9a8594a1a258",
      "name": "Help text",
      "parameters": {
        "jsCode": "return [{ json: { help: \"I plan and write the page's posts with you:\\n• around the 20th: two offers for next month to approve\\n• after approval: the month's plan, then each draft a few days before it goes out\\n• on the 1st: a retro with rules for next month\\n\\nReply to any card or question of mine to answer or change it. Anything else you send me is saved to the story bank for future stories.\\n\\nCommands:\\n/offers [YYYY-MM]: propose offers again (default next month)\\n/plan YYYY-MM: plan the approved offers of a month\\n/status: the next 14 days\\n/draft <piece id>: draft a piece now\\n/retro [YYYY-MM]: review a month (default last month)\\n/help\" } }];"
      },
      "position": [
        1540,
        -400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "46ae5ccb-e9cb-5b00-b3a7-d278e1286ebd",
