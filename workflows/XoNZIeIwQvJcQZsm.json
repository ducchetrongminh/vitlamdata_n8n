      "parameters": {
        "jsCode": "const TZ = 'Asia/Ho_Chi_Minh';\n// The NocoDB node nests a row as { id, id_fields, fields }.\nconst rowsOf = (name) => $(name).all()\n  .map((i) => i.json || {})\n  .filter((j) => j.id !== undefined && j.id !== null)\n  .map((j) => ({ Id: j.id, ...(j.fields || {}) }));\nconst settingsOf = (name) => Object.fromEntries(\n  rowsOf(name).filter((r) => r.key).map((r) => [r.key, (r.value ?? '').toString().trim()]));\nconst parseDt = (s) => DateTime.fromISO(String(s || '').trim().replace(' ', 'T'), { setZone: true }).setZone(TZ);\nconst parseDate = (s) => DateTime.fromISO(String(s || '').trim().slice(0, 10), { zone: TZ });\n\nconst pieces = rowsOf('Load upcoming');\nconst icon = { planned: '·', drafting: '✍️', awaiting_approval: '🟡', needs_attention: '⚠️', approved: '✅', scheduled: '🕒', published: '📣', rejected: '✖️' };\nconst text = pieces.length\n  ? ['Next 14 days:', ...pieces.map((p) => `${icon[p.status] || p.status} ${parseDt(p.publish_at).toFormat('dd/MM')} #${p.Id} ${p.kind}: ${p.title}`),\n    '', '· planned  ✍️ drafting  🟡 waiting for you  ⚠️ failed check  ✅ approved  📣 posted'].join('\\n')\n  : 'Nothing planned for the next 14 days. Approve offers (or send /offers) to get a plan.';\nreturn [{ json: { text, reply_to: $('Read message').first().json.message_id } }];"
