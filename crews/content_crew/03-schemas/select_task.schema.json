{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "select_task@1",
  "title": "Today's pick list",
  "type": "object",
  "required": ["quota", "allowed_types", "bank", "recent_posts"],
  "additionalProperties": false,
  "properties": {
    "quota": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "How many posts to write today. Code's decision, not the model's."
    },
    "allowed_types": {
      "type": "array",
      "minItems": 1,
      "description": "Code has already removed offer when the month's two are used.",
      "items": { "type": "string", "enum": ["observation", "story", "education", "offer"] }
    },
    "bank": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["idea_id", "theme", "source", "banked_at"],
        "additionalProperties": false,
        "properties": {
          "idea_id": { "type": "integer" },
          "theme": { "type": "string" },
          "hook": { "type": ["string", "null"] },
          "angle": { "type": ["string", "null"] },
          "source": { "type": "string", "enum": ["owner", "scout"] },
          "banked_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "recent_posts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["post_id", "content_type", "theme"],
        "additionalProperties": false,
        "properties": {
          "post_id": { "type": "integer" },
          "content_type": { "type": "string" },
          "theme": { "type": "string" },
          "published_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "lessons": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 250 } },
    "now": { "type": "string", "format": "date-time" }
  }
}
