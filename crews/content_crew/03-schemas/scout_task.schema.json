{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scout_task@1",
  "title": "What to go looking for",
  "type": "object",
  "required": ["topics", "want", "recent_themes"],
  "additionalProperties": false,
  "properties": {
    "topics": {
      "type": "array",
      "minItems": 1,
      "description": "Standing topics from settings, changed by the owner in chat.",
      "items": { "type": "string" }
    },
    "want": { "type": "integer", "minimum": 1, "maximum": 10 },
    "recent_themes": {
      "type": "array",
      "description": "Already in the bank; do not come back with these.",
      "items": { "type": "string" }
    },
    "avoid": {
      "type": "array",
      "description": "Subjects the page does not touch.",
      "items": { "type": "string" }
    }
  }
}
