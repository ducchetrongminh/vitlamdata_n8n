# Values for the ${VAR} placeholders in credentials/*.json. Copy to .credentials.env (gitignored)
# and fill in. A credential with any empty placeholder is skipped by scripts/push-credentials.sh.

# credentials: Nocodb bot (nocoDbApiToken)
NOCODB_API_KEY=
NOCODB_HOST=

# credentials: DeepSeek bot (deepSeekApi)
DEEPSEEK_API_KEY=

# credentials: Lark content bot (httpCustomAuth). App ID and App Secret of the Lark custom app,
# from open.larksuite.com > the app > Credentials & Basic Info.
LARK_APP_ID=
LARK_APP_SECRET=

# credentials: Facebook page (facebookGraphApi). Page access token of the Vịt Làm Data page that
# never expires; README "Publishing to Facebook" shows how to get it. With a page token the Graph
# API's "me" is the page, so no page id is needed.
FACEBOOK_PAGE_TOKEN=
